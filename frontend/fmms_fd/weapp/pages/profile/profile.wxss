.profile-page {
  min-height: 100vh;
  background:
    linear-gradient(rgba(248, 243, 238, 0.26), rgba(248, 243, 238, 0.14)),
    radial-gradient(circle at 80% 10%, #f7e8da 0%, #efe6de 36%, #e8e6e5 100%);
  position: relative;
  overflow: hidden;
}

.profile-backdrop {
  position: fixed;
  inset: 0;
  pointer-events: none;
}

.glow {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  filter: blur(30rpx);
  opacity: 0.5;
}

.glow-left {
  left: -120rpx;
  top: 170rpx;
  background: rgba(212, 176, 140, 0.5);
}

.glow-right {
  right: -140rpx;
  top: 40rpx;
  background: rgba(198, 153, 118, 0.42);
}

.profile-scroll {
  height: 100vh;
}

.profile-shell {
  position: relative;
  z-index: 2;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 32rpx;
  display: grid;
  gap: 20rpx;
}

.profile-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.08);
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.92);
}

.back-icon {
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 700;
}

.back-text {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.topbar-title {
  color: #261c16;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-card {
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 22rpx 52rpx rgba(36, 26, 20, 0.12);
}

.hero-card {
  padding: 26rpx;
  display: grid;
  justify-items: center;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 10rpx;
  justify-self: start;
}

.brand-icon-image {
  width: 48rpx;
  height: 48rpx;
  display: block;
  flex-shrink: 0;
}

.brand-name {
  color: #111827;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.brand-dot {
  color: #d4b08c;
}

.profile-avatar {
  margin-top: 22rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #d4b08c 0%, #b28059 100%);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 30rpx rgba(178, 128, 89, 0.24);
}

.profile-name {
  margin-top: 14rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-sub {
  margin-top: 6rpx;
  color: #7d6f65;
  font-size: 24rpx;
}

.info-card {
  padding: 8rpx 18rpx;
}

.info-row {
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid rgba(145, 106, 74, 0.12);
}

.info-label {
  color: #7d6f65;
  font-size: 24rpx;
}

.info-value {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.action-list {
  display: grid;
  gap: 12rpx;
}

.action-btn {
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(14rpx);
  padding: 18rpx;
}

.action-home:active {
  background: rgba(255, 255, 255, 0.9);
}

.action-logout {
  border-color: rgba(248, 113, 113, 0.22);
  background: rgba(255, 245, 245, 0.8);
}

.action-logout:active {
  background: rgba(255, 237, 237, 0.9);
}

.action-title {
  display: block;
  color: #261c16;
  font-size: 28rpx;
  font-weight: 700;
}

.action-sub {
  display: block;
  margin-top: 6rpx;
  color: #7d6f65;
  font-size: 23rpx;
}

.profile-footer {
  margin-top: 6rpx;
  text-align: center;
  color: #8d95a1;
  font-size: 22rpx;
  padding-bottom: 10rpx;
}
