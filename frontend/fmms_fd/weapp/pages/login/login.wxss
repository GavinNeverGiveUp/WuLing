.auth-page {
  min-height: 100vh;
  background:
    linear-gradient(rgba(248, 243, 238, 0.26), rgba(248, 243, 238, 0.14)),
    radial-gradient(circle at 20% 10%, #f7e8da 0%, #efe6de 36%, #e8e6e5 100%);
  position: relative;
  overflow: hidden;
}

.auth-backdrop {
  position: fixed;
  inset: 0;
  pointer-events: none;
}

.glow {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  filter: blur(30rpx);
  opacity: 0.5;
}

.glow-left {
  left: -120rpx;
  top: 140rpx;
  background: rgba(212, 176, 140, 0.5);
}

.glow-right {
  right: -140rpx;
  top: 30rpx;
  background: rgba(198, 153, 118, 0.42);
}

.auth-scroll {
  height: 100vh;
}

.auth-shell {
  position: relative;
  z-index: 2;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 32rpx;
  display: grid;
  gap: 20rpx;
}

.auth-story,
.auth-card {
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 22rpx 52rpx rgba(36, 26, 20, 0.12);
}

.auth-story {
  padding: 26rpx;
}

.story-badge {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(199, 159, 125, 0.18);
  color: #946b4a;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.story-title {
  display: block;
  margin-top: 16rpx;
  color: #261c16;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 700;
}

.story-title-accent {
  color: #d4b08c;
}

.story-copy {
  display: block;
  margin-top: 12rpx;
  color: #655951;
  font-size: 25rpx;
  line-height: 1.72;
}

.story-points {
  margin-top: 20rpx;
  display: grid;
  gap: 12rpx;
}

.story-point {
  background: rgba(255, 255, 255, 0.56);
  border-radius: 20rpx;
  padding: 16rpx;
}

.story-point-title {
  display: block;
  color: #2d231c;
  font-size: 26rpx;
  font-weight: 700;
}

.story-point-copy {
  display: block;
  margin-top: 6rpx;
  color: #786b62;
  font-size: 23rpx;
  line-height: 1.6;
}

.auth-card {
  padding: 24rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.brand-icon-image {
  width: 48rpx;
  height: 48rpx;
  display: block;
  flex-shrink: 0;
}

.brand-name {
  color: #111827;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.brand-dot {
  color: #d4b08c;
}

.auth-copy {
  margin-top: 18rpx;
  margin-bottom: 18rpx;
}

.auth-title {
  display: block;
  color: #261c16;
  font-size: 42rpx;
  font-weight: 700;
}

.auth-desc {
  display: block;
  margin-top: 8rpx;
  color: #7d6f65;
  font-size: 24rpx;
}

.form-item + .form-item {
  margin-top: 16rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  color: #6c5f56;
  font-size: 24rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(145, 106, 74, 0.14);
  background: rgba(255, 255, 255, 0.8);
  color: #1f2937;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 22rpx;
  width: 100%;
  border: 0;
  border-radius: 18rpx;
  padding: 0;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #d4b08c, #b28059);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 30rpx rgba(178, 128, 89, 0.24);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.72;
}

.auth-switch {
  margin-top: 20rpx;
  text-align: center;
}

.switch-text {
  color: #7d6f65;
  font-size: 24rpx;
}

.switch-link {
  margin-left: 8rpx;
  color: #9a6f4f;
  font-size: 24rpx;
  font-weight: 700;
}
