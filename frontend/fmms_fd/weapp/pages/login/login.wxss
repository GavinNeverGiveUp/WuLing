.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.login-header {
  text-align: center;
  margin-top: 120rpx;
  margin-bottom: 100rpx;
}

.login-header .title {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 20rpx;
}

.login-header .subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.login-form {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.login-btn {
  width: 100%;
  margin-top: 40rpx;
  border-radius: 8rpx;
}

.register-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.register-link .link {
  color: #1890ff;
  margin-left: 8rpx;
}

.footer {
  margin-top: auto;
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  padding-top: 40rpx;
}
