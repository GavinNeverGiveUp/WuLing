.mobile-page {
  height: 100vh;
  background: linear-gradient(180deg, #fbf6f0 0%, #f8f6f3 35%, #f5f5f4 100%);
  color: #374151;
}

.mobile-topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 1rpx solid #eceff3;
}

.topbar-main {
  min-height: 120rpx;
  padding: 14rpx 18rpx 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.title-block {
  min-width: 0;
  flex: 1;
}

.mobile-brand {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.mobile-brand-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
  flex-shrink: 0;
}

.mobile-brand-name {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.mobile-brand-dot {
  color: #d4b08c;
}

.hello-line {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.hello-muted {
  color: #9ca3af;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.hello-name {
  color: #111827;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-text {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.3;
  display: block;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-top: 8rpx;
}

.notice-trigger {
  position: relative;
  border: 1rpx solid rgba(212, 176, 140, 0.34);
  background: rgba(212, 176, 140, 0.14);
  border-radius: 999rpx;
  padding: 14rpx 20rpx;
}

.notice-trigger:active {
  background: rgba(212, 176, 140, 0.2);
}

.notice-trigger-text {
  color: #8f6746;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.notice-dot {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f87171;
  border: 2rpx solid #ffffff;
}

.icon-btn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn-image {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.icon-btn:active {
  background: #f5f5f6;
}

.icon-text {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 700;
}

.notice-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.18);
  z-index: 36;
}

.notice-panel {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  background: #ffffff;
  border: 1rpx solid #eceff3;
  border-radius: 24rpx;
  padding: 18rpx;
  max-height: 56vh;
  overflow-y: auto;
  z-index: 40;
  box-shadow: 0 16rpx 32rpx rgba(15, 23, 42, 0.16);
}

.notice-panel-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.notice-empty {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.notice-group {
  margin-top: 14rpx;
}

.notice-group-title {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.notice-item {
  border: 1rpx solid #f2f4f7;
  background: #fcfcfd;
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
}

.notice-item + .notice-item {
  margin-top: 8rpx;
}

.notice-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.notice-item-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.notice-item-tag {
  color: #8f6746;
  background: rgba(212, 176, 140, 0.16);
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
  font-size: 20rpx;
}

.notice-item-tag.danger {
  color: #b91c1c;
  background: rgba(248, 113, 113, 0.16);
}

.notice-item-meta {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.3;
  display: block;
}

.chat-scroll {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

.system-tip {
  width: fit-content;
  margin: 0 auto 16rpx;
  background: #ebeef3;
  color: #808995;
  font-size: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.message-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.line-user {
  justify-content: flex-end;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
}

.bot-avatar {
  background: #d4b08c;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(212, 176, 140, 0.24);
}

.user-avatar {
  background: #e5e7eb;
  color: #6b7280;
}

.bubble {
  max-width: 76%;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 1.62;
  padding: 16rpx 18rpx;
  word-break: break-word;
}

.bubble-assistant {
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #e8edf3;
  border-top-left-radius: 6rpx;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.04);
}

.bubble-user {
  background: linear-gradient(135deg, #d4b08c 0%, #c59a72 100%);
  color: #ffffff;
  border-top-right-radius: 6rpx;
  box-shadow: 0 10rpx 20rpx rgba(212, 176, 140, 0.24);
}

.loading-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.loading-text {
  color: #9ca3af;
  font-size: 24rpx;
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(212, 176, 140, 0.36);
  border-top-color: #d4b08c;
  animation: spin 0.8s linear infinite;
}

.mobile-composer {
  position: fixed;
  left: 0;
  right: 0;
  padding: 10rpx 12rpx;
  z-index: 50;
}

.composer-shell {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.14);
}

.composer-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 210rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.45;
  color: #374151;
  padding: 14rpx 8rpx 10rpx;
}

.composer-input::placeholder {
  color: #9ca3af;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #d4b08c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 20rpx rgba(212, 176, 140, 0.24);
}

.send-btn:active {
  background: #c39d7a;
}

.send-btn-disabled {
  opacity: 0.7;
}

.send-btn-disabled:active {
  background: #d4b08c;
}

.send-icon {
  font-size: 34rpx;
  font-weight: 700;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

