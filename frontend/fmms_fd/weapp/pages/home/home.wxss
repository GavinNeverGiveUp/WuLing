.home-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 60rpx 24rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e2e8f0;
  height: 88rpx;
}

.navbar-left,
.navbar-right {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.navbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: normal;
  color: #0f172a;
}

.menu-btn {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx;
  background-color: transparent;
  border-radius: 8rpx;
}

.menu-btn:active {
  background-color: #f1f5f9;
}

.menu-line {
  width: 40rpx;
  height: 4rpx;
  background-color: #64748b;
  border-radius: 2rpx;
}

.chat-container {
  flex: 1;
  overflow: hidden;
}

.messages-list {
  padding: 32rpx;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  gap: 20rpx;
}

.message-right {
  flex-direction: row-reverse;
}

.message-left {
  flex-direction: row;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.message-avatar-user {
  background-color: #0ea5e9;
  color: #fff;
}

.message-avatar-assistant {
  background-color: #22c55e;
  color: #fff;
}

.message-content-wrapper {
  max-width: 70%;
}

.message-sender {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
  display: block;
}

.message-right .message-sender {
  text-align: right;
}

.message-content {
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message-user {
  background-color: #f1f5f9;
  color: #0f172a;
}

.message-assistant {
  background-color: #fff;
  color: #000;
  border: 1rpx solid #e2e8f0;
}

.input-container {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 32rpx;
  background-color: transparent;
  gap: 12rpx;
  position: relative;
  z-index: 10;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  border: 1rpx solid #e2e8f0;
}

.chat-input {
  flex: 1;
  background-color: transparent;
  border: none;
  font-size: 28rpx;
  min-height: 48rpx;
  max-height: 200rpx;
  line-height: 1.5;
  outline: none;
  color: #000;
}

.chat-input::placeholder {
  color: #94a3b8;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s ease;
}

.send-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #684293 100%);
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.send-btn-disabled {
  background-color: #94a3b8;
  box-shadow: none;
}

.send-btn-disabled:active {
  background-color: #94a3b8;
  transform: none;
}

.send-icon {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.typing-indicator {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.typing-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  background-color: #22c55e;
  color: #fff;
}

.typing-content {
  background-color: #fff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e2e8f0;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #64748b;
  border-radius: 50%;
  animation: typing-bounce 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing-bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}
