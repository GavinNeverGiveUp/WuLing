<view class="auth-page">
  <view class="auth-backdrop">
    <view class="glow glow-left"></view>
    <view class="glow glow-right"></view>
  </view>

  <scroll-view class="auth-scroll" scroll-y enhanced show-scrollbar="false">
    <view class="auth-shell" style="padding-top: {{statusBarHeight + 24}}px;">
      <view class="auth-story">
        <text class="story-badge">AI 驱动的家庭秩序</text>
        <text class="story-title">你的家，<text class="story-title-accent">物灵</text>都记得</text>
        <text class="story-copy">像问家人一样问物灵，它会精确告诉你物品在哪间房、哪个柜子，并持续同步家庭库存状态。</text>

        <view class="story-points">
          <view class="story-point">
            <text class="story-point-title">家庭协作</text>
            <text class="story-point-copy">邀请家人一起维护家庭物资状态，共享提醒与位置记录</text>
          </view>
          <view class="story-point">
            <text class="story-point-title">统一入口</text>
            <text class="story-point-copy">寻物、提醒、盘点都在一个产品界面里完成</text>
          </view>
        </view>
      </view>

      <view class="auth-card">
        <view class="brand-lockup">
          <image class="brand-icon-image" src="../../images/logo-home-smile.svg" mode="aspectFit"></image>
          <text class="brand-name">物灵<text class="brand-dot">.</text></text>
        </view>

        <view class="auth-copy">
          <text class="auth-title">注册物灵</text>
          <text class="auth-desc">注册后即可进入物灵控制台。</text>
        </view>

        <view class="form-item">
          <text class="form-label">用户名</text>
          <input
            class="form-input"
            placeholder="请输入你的称呼"
            value="{{username}}"
            bindinput="onUsernameInput"
          />
        </view>

        <view class="form-item">
          <text class="form-label">电子邮箱</text>
          <input
            class="form-input"
            placeholder="example@home.com"
            value="{{email}}"
            bindinput="onEmailInput"
          />
        </view>

        <view class="form-item">
          <text class="form-label">手机号</text>
          <input
            class="form-input"
            placeholder="请输入手机号"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>

        <view class="form-item">
          <text class="form-label">设置密码</text>
          <input
            class="form-input"
            placeholder="至少 8 位字符"
            password
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>

        <view class="agreement-row" bindtap="toggleAgreement">
          <view class="agreement-box {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
          <text class="agreement-text">我已阅读并同意服务协议与隐私政策</text>
        </view>

        <button
          class="submit-btn"
          bindtap="handleRegister"
          loading="{{loading}}"
          disabled="{{loading}}"
        >
          {{loading ? '注册中...' : '立即创建账号'}}
        </button>

        <view class="auth-switch">
          <text class="switch-text">已有账号？</text>
          <text class="switch-link" bindtap="goToLogin">返回登录</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
