<view class="register-container">
  <view class="register-header">
    <text class="title">注册账号</text>
    <text class="subtitle">创建您的FMMS账号</text>
  </view>

  <view class="register-form">
    <view class="form-item">
      <view class="form-item-label">用户名</view>
      <input 
        class="form-item-input" 
        placeholder="请输入用户名"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="form-item">
      <view class="form-item-label">邮箱</view>
      <input 
        class="form-item-input" 
        placeholder="请输入邮箱"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>

    <view class="form-item">
      <view class="form-item-label">手机号</view>
      <input 
        class="form-item-input" 
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <view class="form-item-label">密码</view>
      <input 
        class="form-item-input" 
        placeholder="请输入密码"
        password
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button 
      class="btn-primary register-btn" 
      bindtap="handleRegister"
      loading="{{loading}}"
    >
      注册
    </button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link" bindtap="goToLogin">立即登录</text>
    </view>
  </view>
</view>
